# Copy this file to a new file named .env (Windows: copy .env.example .env), then
# paste your key after the = sign. .env stays on your computer: .gitignore keeps it
# out of git. Values here win over ones typed with `set` in Command Prompt.
ANTHROPIC_API_KEY=

